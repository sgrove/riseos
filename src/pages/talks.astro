  const year = talk.year;
  if (!acc[year]) acc[year] = [];
  acc[year].push(talk);
  return acc;
}, {} as Record<number, typeof talks>);

const years = Object.keys(talksByYear).map(Number).sort((a, b) => b - a);
const featuredTalk = talks.find(t => t.featured);

function getTypeColor(type: string) {
  const colors: Record<string, string> = {
    conference: 'bg-moss-100 text-moss-700',
    workshop: 'bg-warmth/10 text-warmth',
    meetup: 'bg-sand-300 text-stone-700',
    podcast: 'bg-stone-200 text-stone-700',
    panel: 'bg-stone-200 text-stone-700',
    stream: 'bg-stone-200 text-stone-700',
  };
  return colors[type] || 'bg-stone-100 text-stone-600';
}
---

<Layout title="Talks & Workshops — Sean Grove" description="Conference talks, workshops, and podcasts about GraphQL, ReasonML, OCaml, and building the future">
  <!-- Navigation -->
  <nav class="fixed top-0 left-0 right-0 z-50 px-6 py-4 bg-sand-50/90 backdrop-blur-lg shadow-sm">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
      <a href="/" class="text-stone-800 font-serif text-xl tracking-wide hover:text-warmth transition-colors">
        SG
      </a>
      <div class="flex items-center gap-8">
        <a href="/talks" class="text-warmth text-sm tracking-wide transition-colors font-medium">
          Talks
        </a>
        <a href="/projects" class="text-stone-600 hover:text-stone-900 text-sm tracking-wide transition-colors">
          Projects
        </a>
        <a href="/ml-explorations" class="text-stone-600 hover:text-stone-900 text-sm tracking-wide transition-colors">
          ML
        </a>
        <a href="/blog" class="text-stone-600 hover:text-stone-900 text-sm tracking-wide transition-colors">
          Blog
        </a>
      </div>
    </div>
  </nav>

  <main class="pt-32 pb-20 px-6">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <header class="mb-16 text-center">
        <span class="text-moss-600 text-sm tracking-[0.3em] uppercase mb-4 block">
          Speaking
        </span>
        <h1 class="text-4xl md:text-6xl font-serif text-stone-800 mb-6">
          Talks & Workshops
        </h1>
        <p class="text-stone-600 text-lg max-w-2xl mx-auto">
          Conference talks, workshops, and podcasts about GraphQL, ReasonML, OCaml, unikernels, and building the future of software.
        </p>
      </header>

      <!-- Featured Talk -->
      {featuredTalk && (
        <section class="mb-20">
          <div class="relative bg-gradient-to-br from-stone-800 to-stone-900 rounded-3xl p-8 md:p-12 text-sand-50 overflow-hidden">
            <div class="absolute top-0 right-0 w-64 h-64 bg-moss-600/10 rounded-full blur-3xl" />
            <div class="absolute bottom-0 left-0 w-48 h-48 bg-warmth/10 rounded-full blur-3xl" />
            
            <div class="relative z-10">
              <div class="flex flex-wrap items-center gap-3 mb-6">
                <span class="px-4 py-1.5 bg-warmth/90 text-white text-sm font-medium rounded-full">
                  Featured
                </span>
                {featuredTalk.views && (
                  <span class="px-4 py-1.5 bg-white/10 text-sand-200 text-sm rounded-full">
                    {featuredTalk.views}
                  </span>
                )}
              </div>
              
              <h2 class="text-3xl md:text-5xl font-serif mb-4">
                {featuredTalk.title}
              </h2>
              <p class="text-sand-300 mb-2 flex items-center gap-2">
                {getEventLogo(featuredTalk.event) && (
                  <img 
                    src={getEventLogo(featuredTalk.event)} 
                    alt="" 
                    class="w-5 h-5 rounded object-contain bg-white/10 p-0.5"
                    onerror="this.style.display='none'"
                  />
                )}
                {featuredTalk.event} · {featuredTalk.year}
              </p>
              <p class="text-sand-300 mb-2">{featuredTalk.location}</p>
              <p class="text-sand-400 text-lg max-w-3xl mb-8 leading-relaxed">
                {featuredTalk.topic}
              </p>
              
              {featuredTalk.videoUrl && (
                <a 
                  href={featuredTalk.videoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-6 py-3 bg-sand-50 text-stone-800 rounded-full hover:bg-white transition-colors font-medium group"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                  Watch Talk
                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              )}

              {/* Coverage Links */}
              {featuredTalk.coverage && featuredTalk.coverage.length > 0 && (
                <div class="mt-8 pt-6 border-t border-white/10">
                  <h4 class="text-sand-300 text-sm font-medium mb-4 flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                    </svg>
                    Coverage & Discussion
                  </h4>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    {featuredTalk.coverage.map((item: any) => (
                      <a 
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-start gap-3 p-3 bg-white/5 hover:bg-white/10 rounded-lg transition-colors group"
                      >
                        <div class="w-8 h-8 rounded bg-white/10 flex items-center justify-center flex-shrink-0">
                          {/* X/Twitter */}
                          {item.url.includes('x.com') || item.url.includes('twitter.com') ? (
                            <svg class="w-4 h-4 text-sand-300" fill="currentColor" viewBox="0 0 24 24">
                              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                            </svg>
                          ) : item.url.includes('linkedin.com') ? (
                            <svg class="w-4 h-4 text-sand-300" fill="currentColor" viewBox="0 0 24 24">
                              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                            </svg>
                          ) : item.url.includes('youtube.com') || item.url.includes('youtu.be') ? (
                            <svg class="w-4 h-4 text-sand-300" fill="currentColor" viewBox="0 0 24 24">
                              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                            </svg>
                          ) : item.type === 'podcast' ? (
                            <svg class="w-4 h-4 text-sand-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                            </svg>
                          ) : (
                            <svg class="w-4 h-4 text-sand-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                          )}
                        </div>
                        <div class="flex-1 min-w-0">
                          <p class="text-sand-100 text-sm font-medium truncate group-hover:text-white transition-colors">{item.title}</p>
                          <p class="text-sand-400 text-xs">{item.source}</p>
                        </div>
                        <svg class="w-4 h-4 text-sand-400 group-hover:text-sand-200 transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>

            <div class="absolute right-8 bottom-8 md:right-16 md:bottom-16 opacity-10">
              <svg class="w-32 h-32" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z" />
              </svg>
            </div>
          </div>
        </section>
      )}

      <!-- Talks by Year -->
      {years.map(year => (
        <section class="mb-16">
          <h2 class="text-2xl font-serif text-stone-800 mb-8 pb-4 border-b border-sand-200">
            {year}
          </h2>
          <div class="space-y-6">
            {talksByYear[year].filter(t => !t.featured).map(talk => (
              <article class="bg-white/60 backdrop-blur-sm rounded-2xl p-6 md:p-8 border border-sand-200 hover:shadow-lg hover:shadow-stone-200/50 transition-all duration-500 group">
                <div class="flex flex-col md:flex-row md:items-start gap-4 md:gap-6">
                  <div class="flex-1">
                    <div class="flex flex-wrap items-center gap-2 mb-3">
                      <span class={`px-3 py-1 text-xs font-medium rounded-full ${getTypeColor(talk.type)}`}>
                        {talk.type}
                      </span>
                      <span class="text-stone-500 text-sm flex items-center gap-1.5">
                        {getEventLogo(talk.event) && (
                          <img 
                            src={getEventLogo(talk.event)} 
                            alt="" 
                            class="w-4 h-4 rounded object-contain"
                            onerror="this.style.display='none'"
                          />
                        )}
                        {talk.event}
                      </span>
                    </div>
                    
                    <h3 class="text-xl md:text-2xl font-serif text-stone-800 mb-2 group-hover:text-warmth transition-colors">
                      {talk.videoUrl ? (
                        <a href={talk.videoUrl} target="_blank" rel="noopener noreferrer" class="hover:text-warmth">
                          {talk.title}
                        </a>
                      ) : talk.title}
                    </h3>
                    
                    <p class="text-stone-500 text-sm mb-3">
                      {talk.location} {talk.date && `· ${talk.date}`}
                    </p>
                    
                    {talk.topic && (
                      <p class="text-stone-600 leading-relaxed">
                        {talk.topic}
                      </p>
                    )}

                    {/* Coverage Links */}
                    {talk.coverage && talk.coverage.length > 0 && (
                      <div class="mt-4 pt-4 border-t border-sand-200">
                        <p class="text-stone-500 text-xs font-medium mb-2">Coverage:</p>
                        <div class="flex flex-wrap gap-2">
                          {talk.coverage.map((item: any) => (
                            <a 
                              href={item.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="inline-flex items-center gap-1.5 px-2 py-1 bg-sand-100 hover:bg-sand-200 rounded text-xs text-stone-600 hover:text-stone-800 transition-colors"
                            >
                              {/* Platform icon */}
                              {item.url.includes('x.com') || item.url.includes('twitter.com') ? (
                                <svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                                </svg>
                              ) : item.url.includes('linkedin.com') ? (
                                <svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                </svg>
                              ) : item.url.includes('youtube.com') || item.url.includes('youtu.be') ? (
                                <svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                                </svg>
                              ) : item.url.includes('github.com') ? (
                                <svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                                </svg>
                              ) : item.type === 'podcast' ? (
                                <svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                                  <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.5 17.5h-3v-6c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v6h-3V9h3v1.13c.69-.78 1.69-1.13 2.63-1.13 2.07 0 3.37 1.63 3.37 3.87v4.63z"/>
                                </svg>
                              ) : (
                                <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                                </svg>
                              )}
                              {item.source}
                              <svg class="w-3 h-3 flex-shrink-0 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                              </svg>
                            </a>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                  
                  {talk.videoUrl && (
                    <div class="flex-shrink-0">
                      <a 
                        href={talk.videoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 text-sm text-warmth hover:text-warmth-light transition-colors font-medium"
                      >
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M8 5v14l11-7z" />
                        </svg>
                        Watch
                      </a>
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}

      <!-- Stats -->
      <section class="mt-20 py-12 border-t border-sand-200">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div>
            <p class="text-4xl font-serif text-stone-800 mb-2">{talks.length}+</p>
            <p class="text-stone-600 text-sm">Talks Given</p>
          </div>
          <div>
            <p class="text-4xl font-serif text-stone-800 mb-2">{years.length}</p>
            <p class="text-stone-600 text-sm">Years Speaking</p>
          </div>
          <div>
            <p class="text-4xl font-serif text-stone-800 mb-2">20+</p>
            <p class="text-stone-600 text-sm">Countries</p>
          </div>
          <div>
            <p class="text-4xl font-serif text-stone-800 mb-2">1M+</p>
            <p class="text-stone-600 text-sm">Video Views</p>
          </div>
        </div>
      </section>
    </div>
  </main>

  <!-- Footer -->
  <footer class="py-12 px-6 border-t border-sand-200">
    <div class="max-w-6xl mx-auto text-center text-stone-500 text-sm">
      <p>© {new Date().getFullYear()} Sean Grove. All rights reserved.</p>
    </div>
  </footer>
</Layout>
